generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pastes     Paste[]
  fileShares FileShare[]
}

model Paste {
  id               String   @id @default(cuid())
  slug             String   @unique @default(nanoid(8))
  title            String
  content          String   @db.Text
  isPasswordLocked Boolean  @default(false)
  password         String?
  viewsCount        Int      @default(0)
  maxViews         Int? // Nullable: null means unlimited views
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  expiresAt        DateTime

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([slug])
  @@index([expiresAt])
  @@index([userId])
}

model FileShare {
  id               String   @id @default(cuid())
  slug             String   @unique
  isPasswordLocked Boolean  @default(false)
  password         String?
  downloadCount    Int      @default(0)
  downloadLimit    Int? // Nullable: null means unlimited downloads
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  expiresAt        DateTime

  files File[]

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([slug])
  @@index([expiresAt])
  @@index([userId])
}

model File {
  id       String @id @default(cuid())
  fileUrl  String
  fileName String
  fileSize Int
  mimeType String

  fileShare   FileShare @relation(fields: [fileShareId], references: [id], onDelete: Cascade)
  fileShareId String

  @@index([fileShareId])
}
