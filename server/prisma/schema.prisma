generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pastes      Paste[]
  fileRecords FileRecord[]
}

model Paste {
  id               String   @id @default(cuid())
  slug             String   @unique @default(nanoid(8))
  title            String
  content          String   @db.Text
  isPasswordLocked Boolean  @default(false)
  password         String?
  viewsCount       Int      @default(0)
  maxViews         Int? // Nullable: null means unlimited views
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  expiresAt        DateTime

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([slug])
  @@index([expiresAt])
  @@index([userId])
}

model FileRecord {
  id   String @id @default(cuid())
  slug String @unique @default(nanoid(8))

  // Storage & Metadata
  fileUrl  String //Stores Cloudinary public_id (e.g. "passlink_uploads/1710000000_bundle")
  fileName String // Original filename shown to user (e.g. "bundle.zip")
  fileSize Int // Size in bytes
  mimeType String @default("application/zip")

  // Protection & Limits
  isPasswordLocked Boolean @default(false)
  password         String?
  downloadCount    Int     @default(0)
  downloadLimit    Int? // Nullable: null means unlimited downloads

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  // Relations
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([slug])
  @@index([expiresAt])
  @@index([userId])
}
